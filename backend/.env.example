# ---- Grok (xAI) ----
GROK_API_KEY=
GROK_MODEL=grok-4
GROK_BASE_URL=https://api.x.ai/v1
# auto = use Grok when GROK_API_KEY is set, otherwise the offline demo engine. Or force: grok | mock
LLM_MODE=auto

# ---- Supabase ----
# Project Settings -> Database -> Connection string (URI). Use the Session pooler URI on Render.
# Leave empty to use a local SQLite file for development.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
# Long random string used to sign player tokens: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET=change-me
# Your Vercel URL(s), comma separated. *.vercel.app previews are allowed automatically.
FRONTEND_URL=http://localhost:5173
SESSION_MINUTES=10
